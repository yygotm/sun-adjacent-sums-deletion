theorem plane_rows_complete (a b c : ZMod 3 × ZMod 3)
    (h : ({0,a,b,c} : Finset (ZMod 3 × ZMod 3)).card=4) :
    ∃ i : Fin 56, planeHoleRows i={0,a,b,c} := by
  have hall : ∀ a b c : ZMod 3 × ZMod 3,
      ({0,a,b,c} : Finset (ZMod 3 × ZMod 3)).card=4 →
      ∃ i : Fin 56, planeHoleRows i={0,a,b,c} := by decide
  exact hall a b c h

theorem plane_row_valid (i : Fin 56) :
    HasRainbowCycle ((planeHoleRows i : Set (ZMod 3 × ZMod 3))ᶜ) := by
  apply cycle_of_certificate (by decide : 2≤5) (planeCycleRows i)
  · have h : ∀ i : Fin 56, (List.ofFn (planeCycleRows i)).Nodup := by decide
    exact h i
  · have h : ∀ i : Fin 56,
        (List.ofFn (fun j => planeCycleRows i j+planeCycleRows i (finRotate 5 j))).Nodup := by decide
    exact h i
  · have h : ∀ i : Fin 56, ∀ x : ZMod 3 × ZMod 3,
        x∈List.ofFn (planeCycleRows i) ↔ x∉planeHoleRows i := by decide
    intro x
    exact h i x

theorem normalized_plane_four (D : Finset (ZMod 3 × ZMod 3))
    (hD : D.card=4) (h0 : 0∈D) : HasRainbowCycle ((D : Set (ZMod 3 × ZMod 3))ᶜ) := by
  have he : (D.erase 0).card=3 := by rw [Finset.card_erase_of_mem h0,hD]
  obtain ⟨a,b,c,_,_,_,hc⟩ := Finset.card_eq_three.mp he
  have hd : D={0,a,b,c} := by rw [← Finset.insert_erase h0,hc]
  obtain ⟨i,hi⟩ := plane_rows_complete a b c (hd ▸ hD)
  have hh := plane_row_valid i
  rw [hi,← hd] at hh
  exact hh

theorem plane_four (D : Finset (ZMod 3 × ZMod 3)) (hD : D.card=4) :
    HasRainbowCycle ((D : Set (ZMod 3 × ZMod 3))ᶜ) := by
  obtain ⟨a,ha⟩ := Finset.card_pos.mp (by omega : 0<D.card)
  let E := D.map (Equiv.addRight (-a)).toEmbedding
  have hE : E.card=4 := by simpa [E] using hD
  have h0 : 0∈E := Finset.mem_map.mpr ⟨a,ha,by simp⟩
  have hh := translate_finset_cycle E a (normalized_plane_four E hE h0)
  have he : E.map (Equiv.addRight a).toEmbedding=D := by
    ext x
    simp [E,Finset.mem_map]
  rwa [he] at hh

