import SunThreeDeletion.TwoFibers
import SunThreeDeletion.OneHoleGroup
import SunThreeDeletion.LiftThree

set_option autoImplicit false
namespace SunThreeDeletion
open SunTwoDeletion

variable {G : Type*} [AddCommGroup G] [Finite G]

/-- Quotient generation in a subgroup generated by H and one additional element. -/
theorem quotient_generator_in_sup (H K : AddSubgroup G) (hHK : H ≤ K) (r : K)
    (hK : K ≤ H ⊔ AddSubgroup.zmultiples (r : G)) :
    ∀ z : K ⧸ H.addSubgroupOf K,
      z ∈ AddSubgroup.zmultiples (QuotientAddGroup.mk r) := by
  intro z
  obtain ⟨x,rfl⟩ := QuotientAddGroup.mk_surjective z
  obtain ⟨a,ha,b,hb,hab⟩ := AddSubgroup.mem_sup.mp (hK x.property)
  obtain ⟨n,hn⟩ := hb
  change n • (r : G) = b at hn
  let aK : K := ⟨a,hHK ha⟩
  have heq : aK+n • r=x := by
    apply Subtype.ext
    change a+n • (r : G)=(x : G)
    rw [hn]
    exact hab
  have hzero : (QuotientAddGroup.mk aK : K ⧸ H.addSubgroupOf K) = 0 :=
    (QuotientAddGroup.eq_zero_iff _).mpr ha
  refine ⟨n, ?_⟩
  have hh := congrArg (QuotientAddGroup.mk' (H.addSubgroupOf K)) heq
  have hz' : (QuotientAddGroup.mk' (H.addSubgroupOf K)) aK = 0 := hzero
  rw [map_add,map_zsmul,hz',zero_add] at hh
  exact hh

/-- The large proper cyclic-subgroup case in the proof. -/
theorem separated_from_cyclic_subgroup (hodd : Odd (Nat.card G))
    (H : AddSubgroup G) [IsAddCyclic H] (hH : 5 ≤ Nat.card H)
    (d : H) (hd : d ≠ 0) (r : G) (hr : r ∉ H) :
    HasRainbowCycle ({0,(d : G),r}ᶜ : Set G) := by
  let K := H ⊔ AddSubgroup.zmultiples r
  have hHK : H ≤ K := le_sup_left
  let rK : K := ⟨r, AddSubgroup.mem_sup_right (AddSubgroup.mem_zmultiples r)⟩
  let J : AddSubgroup K := H.addSubgroupOf K
  let dJ : J := ⟨⟨d,hHK d.property⟩,d.property⟩
  have hdJ : dJ ≠ 0 := by
    intro h
    apply hd
    exact Subtype.ext (congrArg (fun x : J => ((x : K) : G)) h)
  have hJcard : Nat.card J = Nat.card H :=
    Nat.card_congr (AddSubgroup.addSubgroupOfEquivOfLe hHK).toEquiv
  haveI : IsAddCyclic J :=
    (AddSubgroup.addSubgroupOfEquivOfLe hHK).symm.isAddCyclic.mp inferInstance
  have hgen := quotient_generator_in_sup H K hHK rK (by exact le_rfl)
  have hR : (QuotientAddGroup.mk rK : K ⧸ J) ≠ 0 := by
    intro h
    have hm : rK ∈ J := (QuotientAddGroup.eq_zero_iff rK).mp h
    exact hr hm
  haveI : Nontrivial (K ⧸ J) := nontrivial_of_ne _ 0 hR
  have hoK := subgroup_odd hodd K
  have hq : 3 ≤ Nat.card (K ⧸ J) := three_le_of_odd_nontrivial _ (quotient_odd hoK J)
  obtain ⟨C1⟩ := one_hole_cyclic_group J (subgroup_odd hoK J) (by omega)
  have hh := two_punctured_fibers hoK J (by omega) hq rK hgen dJ hdJ C1
  have hKcard : 5 ≤ Nat.card K := by
    have hc := Nat.card_le_card_of_injective (f := AddSubgroup.inclusion hHK)
      (AddSubgroup.inclusion_injective hHK)
    omega
  have h := lift_three_cycle hodd K (by omega) 0 (dJ : K) rK hh
  simpa only [AddSubgroup.coe_zero] using h

end SunThreeDeletion

